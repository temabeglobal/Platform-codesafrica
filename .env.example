# Copier vers .env.local (local) — ne jamais committer de vrais secrets.
# Test et production : variables définies sur l'hébergeur, jamais dans le dépôt.
APP_ENV=local            # local | test | production
MONGODB_URI=             # chaîne de connexion MongoDB (une base distincte par environnement)
MONGODB_DB=platform_local   # platform_local | platform_test | platform_prod
PORT=4000
CORS_ORIGINS=http://localhost:5181
ANTHROPIC_API_KEY=       # clé de Sonia (assistante) — à mettre seulement dans .env.local / l'hébergeur
SONIA_MODEL=claude-sonnet-5-5

# Fonction Neon « api » : clé de Sonia (une seule suffit ; Anthropic est utilisée en priorité)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
