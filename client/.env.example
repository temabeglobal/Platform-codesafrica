# local | test | production — détermine le bandeau d'environnement
VITE_APP_ENV=local

# Services Neon — adresses PUBLIQUES de chaque branche (aucun secret côté navigateur).
# local → branche development, test → branche test, production → branche production.
VITE_NEON_LOCAL_AUTH_URL=
VITE_NEON_LOCAL_API_URL=
VITE_NEON_LOCAL_REALTIME_URL=
VITE_NEON_TEST_AUTH_URL=
VITE_NEON_TEST_API_URL=
VITE_NEON_TEST_REALTIME_URL=
VITE_NEON_PROD_AUTH_URL=
VITE_NEON_PROD_API_URL=
VITE_NEON_PROD_REALTIME_URL=
